# Server Configuration
PORT=3000

# Database URL
# This path is relative to the server directory where the node process is started.
DATABASE_URL="file:../prisma/dev.db"

# JWT Secret - It's recommended to change this to a long, random string
JWT_SECRET=a-very-secret-and-secure-key-that-should-be-changed

# CORS Configuration
CORS_ORIGIN=http://localhost:8081
CORS_METHODS=GET,POST,PUT